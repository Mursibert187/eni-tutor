# Copy this file to ".env" and put your API key in it. Never commit or share .env.
DEEPSEEK_API_KEY=

# Optional (defaults shown):
# MODEL=deepseek-chat
# UPSTREAM_BASE_URL=https://api.deepseek.com
# PORT=8000

# Any OpenAI-compatible API works instead of DeepSeek. Use API_KEY for other providers.
#
# OpenRouter:
# UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# API_KEY=your-openrouter-key
# MODEL=provider/model-name
#
# OpenAI:
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# API_KEY=your-openai-key
# MODEL=gpt-4o-mini
#
# Ollama (local, free):
# UPSTREAM_BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=llama3.1
